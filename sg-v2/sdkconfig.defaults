CONFIG_IDF_TARGET="esp32c3"

# --- Flash ---
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# --- Watchdog: the answer to "it hangs now and then and needs a power cycle" ---
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_ESP_TASK_WDT_PANIC=y
# The idle task is NOT watched: under a sustained request flood the higher-priority
# network tasks can legitimately starve it for 10 s, and resetting the device for
# that turns a busy LAN into a denial of service. Liveness of the control loop is
# watched instead - ctl_task subscribes to the task watchdog itself and feeds it
# only when it really ran. A stuck control loop still resets the chip, and a reset
# always leaves the valve closed.
# CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0 is not set
CONFIG_ESP_INT_WDT=y
CONFIG_ESP_INT_WDT_TIMEOUT_MS=300

# --- Coredump: so the next hang leaves a real backtrace instead of guesswork ---
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y
CONFIG_ESP_COREDUMP_MAX_TASKS_NUM=32

# --- HTTP server + WebSocket ---
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512

# --- TLS ---
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096

# --- lwIP: recommended by the reference repo, helps the SSE stream hold its connection ---
CONFIG_LWIP_TCP_MSL=10000
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_LWIP_SO_LINGER=y

# --- No Bluetooth: saves both flash and RAM ---
CONFIG_BT_ENABLED=n

# --- Size optimisation ---
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y

# --- OTA ---
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_BOOTLOADER_APP_ANTI_ROLLBACK=n

# --- WiFi buffers: bound the worst-case heap a request flood can pin down ---
# The defaults (32 dynamic RX + 32 dynamic TX buffers of ~1.6 KB each) let a
# flood take ~100 KB of the heap, starving TLS and the rest of the firmware.
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
